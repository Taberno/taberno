{
  "lexicon": 1,
  "id": "shop.lgtm.commerce.storefront",
  "defs": {
    "main": {
      "type": "record",
      "key": "literal:self",
      "description": "Public, singleton shop window. Identity, branding, accepted currencies, shipping zones, and policy links for a storefront.",
      "record": {
        "type": "object",
        "required": ["storeDid", "displayName", "currencies"],
        "properties": {
          "storeDid": {
            "type": "string",
            "format": "did",
            "description": "The store's DID. Asserting it here gives a canonical did->storefront path so a purchaseClaim's store_did resolves back to the shop."
          },
          "displayName": {
            "type": "string",
            "description": "Human-readable shop name shown to buyers.",
            "maxLength": 256
          },
          "description": {
            "type": "string",
            "description": "Short shop description or tagline.",
            "maxLength": 2000
          },
          "currencies": {
            "type": "array",
            "description": "ISO 4217 currency codes the shop accepts, e.g. \"USD\", \"JPY\".",
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 3
            }
          },
          "shippingZones": {
            "type": "array",
            "description": "Coarse shipping regions the shop serves; exact rates are computed at checkout.",
            "items": {
              "type": "ref",
              "ref": "#shippingZone"
            }
          },
          "policies": {
            "type": "object",
            "description": "Links or text for returns, privacy, and terms.",
            "properties": {
              "returns": {
                "type": "string",
                "description": "Returns/refund policy text or URI.",
                "maxLength": 10000
              },
              "privacy": {
                "type": "string",
                "description": "Privacy policy text or URI.",
                "maxLength": 10000
              },
              "terms": {
                "type": "string",
                "description": "Terms of service text or URI.",
                "maxLength": 10000
              }
            }
          },
          "branding": {
            "type": "object",
            "description": "Logo and brand colors for the public storefront.",
            "properties": {
              "logo": {
                "type": "blob",
                "description": "Shop logo image.",
                "accept": ["image/*"],
                "maxSize": 1000000
              },
              "primaryColor": {
                "type": "string",
                "description": "Primary brand color as a CSS hex string, e.g. \"#101010\".",
                "maxLength": 32
              },
              "accentColor": {
                "type": "string",
                "description": "Accent brand color as a CSS hex string.",
                "maxLength": 32
              }
            }
          }
        }
      }
    },
    "shippingZone": {
      "type": "object",
      "description": "A named shipping region and the ISO 3166-1 alpha-2 country codes it covers.",
      "required": ["code", "label", "countries"],
      "properties": {
        "code": {
          "type": "string",
          "description": "Short zone code, e.g. \"NA\" or \"EU\".",
          "maxLength": 32
        },
        "label": {
          "type": "string",
          "description": "Human-readable zone label.",
          "maxLength": 128
        },
        "countries": {
          "type": "array",
          "description": "ISO 3166-1 alpha-2 country codes in this zone.",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          }
        }
      }
    }
  }
}
