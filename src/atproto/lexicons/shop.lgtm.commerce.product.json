{
  "lexicon": 1,
  "id": "shop.lgtm.commerce.product",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "Public catalog entry: the browsable \"what\" a buyer sees. Every product has at least one variant. `status` is the public lifecycle; a discontinued product stays resolvable but is no longer purchasable.",
      "record": {
        "type": "object",
        "required": ["name", "status", "createdAt"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Product name shown to buyers.",
            "maxLength": 512
          },
          "description": {
            "type": "string",
            "description": "Long-form product description.",
            "maxLength": 20000
          },
          "status": {
            "type": "string",
            "description": "Public lifecycle state. A discontinued product stays resolvable (old receipts/claims keep working) but is no longer purchasable.",
            "knownValues": ["draft", "active", "discontinued", "archived"]
          },
          "images": {
            "type": "array",
            "description": "Product images shown in the storefront.",
            "items": {
              "type": "blob",
              "accept": ["image/*"],
              "maxSize": 1000000
            }
          },
          "brand": {
            "type": "string",
            "description": "Optional brand or maker name.",
            "maxLength": 256
          },
          "options": {
            "type": "array",
            "description": "Configurable option axes (e.g. Size, Color) whose combinations map to variants.",
            "items": {
              "type": "ref",
              "ref": "#option"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "When this product record was created."
          }
        }
      }
    },
    "option": {
      "type": "object",
      "description": "A named option axis and its allowed values.",
      "required": ["name", "values"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Option axis name, e.g. \"Size\".",
          "maxLength": 128
        },
        "values": {
          "type": "array",
          "description": "Allowed values for this axis, e.g. [\"S\", \"M\", \"L\"].",
          "items": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    }
  }
}
