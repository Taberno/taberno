<div class="page-header">
  <div class="page-header__left">
    <a href="/admin/settings" class="page-back">← Settings</a>
    <h1 class="page-title">Import / Export</h1>
    <p class="text-sm text-muted" style="margin-top:0.25rem;">Import from an existing WooCommerce store, or back up and move this whole squaark store.</p>
  </div>
</div>

{{#if error}}
<div class="alert alert-error">
  {{#if (eq error 'no_file')}}Please choose a file to upload.
  {{else if (eq error 'missing_fields')}}Store URL, consumer key and consumer secret are all required.
  {{else}}{{error}}{{/if}}
</div>
{{/if}}

<h2 class="font-semibold mb-3">Import from WooCommerce</h2>

{{#if activeJob}}
{{> import-job job=activeJob}}
{{/if}}

<div class="grid-2">
  <!-- WordPress export file -->
  <div class="card--no-overflow card-body stack-sm">
    <div>
      <h2 class="font-semibold">WordPress export file</h2>
      <p class="text-xs text-muted mt-1">
        In your WooCommerce site: <strong>Tools → Export → All content</strong>, download the XML file, upload it here.
        No API keys needed. Imports products, variants, images, categories and pages.
      </p>
    </div>
    <form method="POST" action="/admin/import/wxr?_csrf={{@root.csrfToken}}" enctype="multipart/form-data" class="stack-sm">
      {{csrf_field}}
      <input type="file" name="file" accept=".xml" required class="form-file">
      <div>
        <button type="submit" class="btn btn-primary">Upload &amp; import</button>
      </div>
    </form>
  </div>

  <!-- WooCommerce REST API -->
  <div class="card--no-overflow card-body stack-sm">
    <div>
      <h2 class="font-semibold">WooCommerce REST API</h2>
      <p class="text-xs text-muted mt-1">
        In your WooCommerce site: <strong>Settings → Advanced → REST API → Add key</strong> (read access is enough).
        Required for orders — WooCommerce doesn't include those in a WordPress export.
      </p>
    </div>
    <form method="POST" action="/admin/import/woocommerce" class="stack-sm">
      {{csrf_field}}
      <div>
        <label class="form-label-xs">Store URL</label>
        <input type="url" name="store_url" placeholder="https://oldstore.com" required class="form-input">
      </div>
      <div>
        <label class="form-label-xs">Consumer key</label>
        <input type="text" name="consumer_key" placeholder="ck_..." required class="form-input font-mono">
      </div>
      <div>
        <label class="form-label-xs">Consumer secret</label>
        <input type="password" name="consumer_secret" placeholder="cs_..." required class="form-input font-mono">
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:1rem;padding-top:0.25rem;">
        <label class="form-check">
          <input type="checkbox" name="import_products" value="on" checked>
          Products &amp; categories
        </label>
        <label class="form-check">
          <input type="checkbox" name="import_orders" value="on" checked>
          Past orders
        </label>
        <label class="form-check">
          <input type="checkbox" name="import_pages" value="on" checked>
          Pages
        </label>
      </div>
      <p class="text-xs text-muted">Pages require WP core REST API access — works with WC keys if the user has editor permissions.</p>
      <div>
        <button type="submit" class="btn btn-primary">Connect &amp; import</button>
      </div>
    </form>
  </div>
</div>

<p class="text-xs text-muted mt-4">
  Re-running an import updates existing records instead of duplicating them (matched by original WooCommerce ID).
  Imported orders are record-only — payment details aren't carried over.
  Pages are imported as HTML content; they'll be served from <code>/{slug}</code>.
</p>

{{#if jobs.length}}
<div class="card--no-overflow card-body mt-6">
  <h2 class="font-semibold mb-3">Recent WooCommerce imports</h2>
  <table class="data-table">
    <thead>
      <tr>
        <th>Source</th>
        <th>Status</th>
        <th>Result</th>
        <th>When</th>
      </tr>
    </thead>
    <tbody>
      {{#each jobs}}
      <tr>
        <td>{{this.source}}</td>
        <td>
          {{#if (eq this.status 'completed')}}<span class="text-xs font-medium" style="color:#16a34a;">Completed</span>{{/if}}
          {{#if (eq this.status 'failed')}}<span class="text-xs font-medium" style="color:#dc2626;">Failed</span>{{/if}}
          {{#if (eq this.status 'running')}}<span class="text-xs font-medium" style="color:#2563eb;">Running</span>{{/if}}
        </td>
        <td class="text-muted">{{this.stage}}</td>
        <td class="text-muted text-xs">{{date_short this.created_at}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{/if}}

<h2 class="font-semibold mb-3 mt-8" style="padding-top:1.5rem;border-top:1px solid #e5e7eb;">Store backup &amp; transfer</h2>
<p class="text-sm text-muted mb-4">Move this entire squaark store to any other install — including your own self-hosted server — or keep a full backup. It's your data, so there's no lock-in either way.</p>

<div class="grid-2">
  <!-- Export whole store -->
  <div class="card--no-overflow card-body stack-sm">
    <h3 class="font-semibold">Export store</h3>
    <p class="form-hint">Downloads your whole store — products, pages, settings, media and theme — as a single <code>.zip</code> you can import into any other squaark install, including a self-hosted one.</p>
    <p class="form-hint" style="color:#92400e;background:#fffbeb;border:1px solid #fde68a;border-radius:0.375rem;padding:0.5rem 0.65rem;">
      This file contains everything, including your payment/SMTP <strong>secrets and admin logins</strong>. Keep it private — treat it like a password.
    </p>
    <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.85rem;">
      <input type="checkbox" id="export-digital"> Include digital product files (larger download)
    </label>
    <a id="export-btn" class="btn btn-primary" href="/admin/import/export" onclick="this.href='/admin/import/export' + (document.getElementById('export-digital').checked ? '?digital=1' : '')">
      Download store export
    </a>
  </div>

  <!-- Import whole store -->
  <div class="card--no-overflow card-body stack-sm">
    <h3 class="font-semibold">Import store</h3>
    <p class="form-hint" style="color:#991b1b;background:#fef2f2;border:1px solid #fecaca;border-radius:0.375rem;padding:0.5rem 0.65rem;">
      <strong>This replaces everything</strong> in this store — products, orders, settings, admin logins, media — with the contents of the uploaded export, then restarts. There's no undo. Use an empty/new store.
    </p>
    <form method="POST" action="/admin/import/store?_csrf={{@root.csrfToken}}" enctype="multipart/form-data"
          onsubmit="return confirm('This will permanently REPLACE this entire store with the uploaded export, then restart. Continue?');">
      <input type="file" name="file" accept=".zip,application/zip" required class="form-input" style="margin-bottom:0.5rem;">
      <button type="submit" class="btn" style="color:#b91c1c;border-color:#fecaca;">Import &amp; replace this store</button>
    </form>
  </div>
</div>

{{#if cloudMode}}
<p class="text-sm text-muted mt-4">
  You don't need to export for safekeeping — Squaark Cloud backs this store up automatically every night, without downtime. See and trigger backups from
  <a href="https://cloud.squaark.com" target="_blank" rel="noopener">your Squaark Cloud dashboard</a>. The export above is for taking your store elsewhere.
</p>
{{/if}}
