<div class="page-header">
  <h1 class="page-title">Settings</h1>
</div>

{{#if saved}}<div class="alert alert-success">Settings saved.</div>{{/if}}
{{#if error}}<div class="alert alert-error">{{error}}</div>{{/if}}

<div class="settings-layout" x-data="settingsTabs()">

  <!-- Sidebar nav -->
  <nav class="settings-nav">
    <ul>
      <li><button @click="tab = 'store'" :class="tab === 'store' ? 'settings-tab settings-tab--active' : 'settings-tab'" class="settings-tab">Store</button></li>
      {{#unless cloudMode}}
      <li><button @click="tab = 'email'" :class="tab === 'email' ? 'settings-tab settings-tab--active' : 'settings-tab'" class="settings-tab">Email</button></li>
      {{/unless}}
      <li><button @click="tab = 'payments'" :class="tab === 'payments' ? 'settings-tab settings-tab--active' : 'settings-tab'" class="settings-tab">Payments</button></li>
      <li><button @click="tab = 'tax'" :class="tab === 'tax' ? 'settings-tab settings-tab--active' : 'settings-tab'" class="settings-tab">Tax</button></li>
      <li><button @click="tab = 'marketing'" :class="tab === 'marketing' ? 'settings-tab settings-tab--active' : 'settings-tab'" class="settings-tab">Marketing</button></li>
      <li><button @click="tab = 'media'" :class="tab === 'media' ? 'settings-tab settings-tab--active' : 'settings-tab'" class="settings-tab">Media</button></li>
      <li><button @click="tab = 'server'" :class="tab === 'server' ? 'settings-tab settings-tab--active' : 'settings-tab'" class="settings-tab">Server</button></li>
      <li><button @click="tab = 'logs'" :class="tab === 'logs' ? 'settings-tab settings-tab--active' : 'settings-tab'" class="settings-tab">Logs</button></li>
      <li><a href="/admin/import" class="settings-tab" style="display:block;text-decoration:none;">Import / Export</a></li>
    </ul>
  </nav>

  <!-- Panels -->
  <div class="settings-main">

    <!-- Store -->
    <div x-show="tab === 'store'" x-cloak>
      <form method="POST" action="/admin/settings">
        {{csrf_field}}
        <div class="card--no-overflow card-body stack-sm">
          <h2 class="font-semibold">Store</h2>
          <div>
            <label class="form-label">Store name</label>
            <input type="text" name="store_name" value="{{settings.store_name}}" class="form-input">
          </div>
          <div>
            <label class="form-label">Tagline</label>
            <input type="text" name="store_tagline" value="{{settings.store_tagline}}" placeholder="A short description shown in the footer" class="form-input">
          </div>
          <div>
            <label class="form-label">Store URL</label>
            <input type="url" name="store_url" value="{{settings.store_url}}" class="form-input">
          </div>
          <div>
            <label class="form-label">Contact email</label>
            <input type="email" name="store_email" value="{{settings.store_email}}" class="form-input">
          </div>
          <div>
            <label class="form-label">Currency</label>
            <select name="store_currency" class="form-select">
              <option value="GBP" {{#if (eq settings.store_currency 'GBP')}}selected{{/if}}>GBP (£)</option>
              <option value="USD" {{#if (eq settings.store_currency 'USD')}}selected{{/if}}>USD ($)</option>
              <option value="EUR" {{#if (eq settings.store_currency 'EUR')}}selected{{/if}}>EUR (€)</option>
            </select>
          </div>
          <div>
            <label class="form-label">Cart label</label>
            <select name="cart_label" class="form-select">
              <option value="Cart" {{#if (eq settings.cart_label 'Cart')}}selected{{/if}}>Cart</option>
              <option value="Basket" {{#if (eq settings.cart_label 'Basket')}}selected{{/if}}>Basket</option>
              <option value="Bag" {{#if (eq settings.cart_label 'Bag')}}selected{{/if}}>Bag</option>
            </select>
            <p class="form-hint">Used throughout the storefront, including its URL — e.g. “Basket” lives at <code>/basket</code>.</p>
          </div>
          <div class="row-between" style="padding:0.25rem 0;">
            <div>
              <p class="text-sm font-medium">Customer accounts</p>
              <p class="form-hint mt-0">Allow customers to register, sign in, and view order history</p>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" name="customer_accounts_enabled" value="1"
                {{#if (ne settings.customer_accounts_enabled '0')}}checked{{/if}}>
              <span class="toggle-track"></span>
            </label>
          </div>
          <div style="padding-top:0.25rem;">
            <label class="form-label">Low-stock alert threshold</label>
            <input type="number" name="low_stock_threshold" value="{{settings.low_stock_threshold}}"
              min="0" placeholder="5" class="form-input" style="max-width:8rem;">
            <p class="form-hint">Email {{#if settings.store_email}}{{settings.store_email}}{{else}}your store email{{/if}} when a product variant drops to this level or below after an order. Leave blank to turn off; 0 alerts only when a variant sells out.</p>
          </div>
          <div style="padding-top:0.25rem;">
            <label class="form-label">Abandoned-checkout reminder (hours)</label>
            <input type="number" name="abandoned_cart_hours" value="{{settings.abandoned_cart_hours}}"
              min="0" placeholder="1" class="form-input" style="max-width:8rem;">
            <p class="form-hint">Email customers who start checkout but don't pay, this many hours later (once). Leave blank or 0 to turn off. Reaches card (Stripe) checkouts where an email was entered.</p>
          </div>
        </div>
        <div class="mt-4">
          <button type="submit" class="btn btn-primary">Save settings</button>
        </div>
      </form>
    </div>

    {{!-- Email delivery is configured at the cloud level, by the control plane,
          so a managed store never sees these fields. --}}
    {{#unless cloudMode}}
    <!-- Email -->
    <div x-show="tab === 'email'" x-cloak>
      <form method="POST" action="/admin/settings/email">
        {{csrf_field}}
        <div class="card--no-overflow card-body stack-sm" x-data="{ provider: '{{settings.email_provider}}' }">
          <h2 class="font-semibold">Email</h2>
          <p class="form-hint -mt-1">
            Configure how order and account emails are sent. Editable email content lives under
            <a href="/admin/emails">Emails</a>.
          </p>
          <div>
            <label class="form-label">From name</label>
            <input type="text" name="email_from_name" value="{{settings.email_from_name}}" placeholder="{{settings.store_name}}" class="form-input">
          </div>
          <div>
            <label class="form-label">From address</label>
            <input type="email" name="email_from_address" value="{{settings.email_from_address}}" placeholder="{{settings.store_email}}" class="form-input">
          </div>
          <div>
            <label class="form-label">Sending method</label>
            <select name="email_provider" x-model="provider" class="form-select">
              <option value="console" {{#if (eq settings.email_provider 'console')}}selected{{/if}}>None yet (log to console — dev only)</option>
              <option value="resend" {{#if (eq settings.email_provider 'resend')}}selected{{/if}}>Resend (recommended)</option>
              <option value="smtp" {{#if (eq settings.email_provider 'smtp')}}selected{{/if}}>Custom SMTP</option>
              <option value="direct" {{#if (eq settings.email_provider 'direct')}}selected{{/if}}>Direct send (no setup — best effort)</option>
            </select>
            <p class="form-hint">Real inboxes reject mail without a proper provider — pick Resend or SMTP before going live.</p>
          </div>
          <div x-show="provider === 'direct'" x-cloak class="stack-sm" style="padding-top:0.5rem;border-top:1px solid #f3f4f6;">
            <p class="form-hint" style="color:#92400e;background:#fffbeb;border:1px solid #fde68a;border-radius:0.375rem;padding:0.5rem 0.65rem;">
              <strong>No configuration needed</strong> — squaark delivers straight to the recipient's mail server.
              But many hosts block this, and without SPF/DKIM records for your domain it often lands in spam.
              Good for low volume if you're happy to tell customers “check your spam folder”; switch to Resend or SMTP
              once deliverability matters. Set a real “Email from address” below on your own domain.
            </p>
          </div>
          <div x-show="provider === 'resend'" x-cloak class="stack-sm" style="padding-top:0.5rem;border-top:1px solid #f3f4f6;">
            <div>
              <label class="form-label">Resend API key</label>
              <input type="password" name="resend_api_key" value=""
                placeholder="{{#if settings.resend_api_key}}Already set — leave blank to keep, or paste a new key to replace{{else}}re_xxxxxxxx{{/if}}"
                class="form-input font-mono" autocomplete="off">
              <p class="form-hint">From <a href="https://resend.com/api-keys" target="_blank">resend.com/api-keys</a>. The from address must be on a verified domain.</p>
            </div>
          </div>
          <div x-show="provider === 'smtp'" x-cloak class="stack-sm" style="padding-top:0.5rem;border-top:1px solid #f3f4f6;">
            <div class="form-row form-row--3">
              <div style="grid-column:span 2;">
                <label class="form-label">SMTP host</label>
                <input type="text" name="smtp_host" value="{{settings.smtp_host}}" placeholder="smtp.example.com" class="form-input">
              </div>
              <div>
                <label class="form-label">Port</label>
                <input type="number" name="smtp_port" value="{{settings.smtp_port}}" class="form-input">
                <p class="form-hint">465 = TLS, 587 = STARTTLS (most common). The port sets the encryption automatically.</p>
              </div>
            </div>
            <div>
              <label class="form-label">Username</label>
              <input type="text" name="smtp_user" value="{{settings.smtp_user}}" class="form-input">
            </div>
            <div>
              <label class="form-label">Password</label>
              <input type="password" name="smtp_pass" value=""
                placeholder="{{#if settings.smtp_pass}}Already set — leave blank to keep{{else}}••••••••{{/if}}"
                class="form-input" autocomplete="off">
            </div>
            <label class="form-check">
              <input type="checkbox" name="smtp_secure" value="1" {{#if (eq settings.smtp_secure '1')}}checked{{/if}}>
              <span class="text-sm">Force TLS — only used for non-standard ports (465/587/25 are handled automatically)</span>
            </label>
          </div>
        </div>
        <div class="mt-4 row">
          <button type="submit" class="btn btn-primary">Save email settings</button>
          <button type="button" hx-post="/admin/settings/email/test" hx-target="#email-test-status" hx-swap="innerHTML"
            class="btn btn-secondary">
            Send test email
          </button>
          <span id="email-test-status"></span>
        </div>
      </form>
    </div>

    {{/unless}}

    <!-- Payments -->

    <div x-show="tab === 'payments'" x-cloak>
      <div class="card--no-overflow card-body stack-sm">
        <h2 class="font-semibold">Payments</h2>

        <!-- Stripe -->
        <div class="stack-sm" style="padding-top:0.75rem;border-top:1px solid #f3f4f6;">
          <h3 class="text-sm font-medium">Stripe</h3>
          <div>
            <label class="form-label-xs">Publishable key</label>
            <input type="text" id="stripe_pk" name="stripe_pk" value="{{settings.stripe_pk}}" placeholder="pk_live_…" class="form-input font-mono">
          </div>
          <div>
            <label class="form-label-xs">Secret key</label>
            <input type="password" id="stripe_sk" name="stripe_sk" value=""
              placeholder="{{#if settings.stripe_sk}}Already set — leave blank to keep{{else}}sk_live_…{{/if}}"
              class="form-input font-mono" autocomplete="off">
          </div>
          <div>
            <label class="form-label-xs">Webhook secret <span class="form-optional">(optional)</span></label>
            <input type="password" id="stripe_webhook_secret" name="stripe_webhook_secret" value=""
              placeholder="{{#if settings.stripe_webhook_secret}}Already set — leave blank to keep{{else}}whsec_…{{/if}}"
              class="form-input font-mono" autocomplete="off">
            <p class="form-hint">Point your Stripe webhook at <code>{{settings.store_url}}/webhooks/stripe</code>, event: <code>checkout.session.completed</code>.</p>
          </div>
        </div>

        <!-- PayPal -->
        <div class="stack-sm" style="padding-top:1rem;border-top:1px solid #f3f4f6;">
          <h3 class="text-sm font-medium">PayPal</h3>
          <div>
            <label class="form-label-xs">Mode</label>
            <select id="paypal_mode" name="paypal_mode" class="form-select">
              <option value="sandbox" {{#if (eq settings.paypal_mode 'sandbox')}}selected{{/if}}>Sandbox (testing)</option>
              <option value="live" {{#if (eq settings.paypal_mode 'live')}}selected{{/if}}>Live</option>
            </select>
          </div>
          <div>
            <label class="form-label-xs">Client ID</label>
            <input type="text" id="paypal_client_id" name="paypal_client_id" value="{{settings.paypal_client_id}}" placeholder="AXxx…" class="form-input font-mono">
          </div>
          <div>
            <label class="form-label-xs">Client secret</label>
            <input type="password" id="paypal_client_secret" name="paypal_client_secret" value=""
              placeholder="{{#if settings.paypal_client_secret}}Already set — leave blank to keep{{else}}EXxx…{{/if}}"
              class="form-input font-mono" autocomplete="off">
          </div>
        </div>

        <div style="padding-top:0.5rem;">
          <button type="button" onclick="savePayments()" class="btn btn-primary">Save payment settings</button>
        </div>
      </div>
    </div>

    <!-- Tax -->
    <div x-show="tab === 'tax'" x-cloak>
      <form method="POST" action="/admin/settings/tax">
        {{csrf_field}}
        <div class="card--no-overflow card-body stack-sm">
          <h2 class="font-semibold">Tax</h2>
          <p class="form-hint -mt-1">Prices are treated as tax-inclusive (VAT/GST already in the price). The tax amount shown on orders is calculated from the rate you set here.</p>

          <div class="row-between" style="padding:0.25rem 0;">
            <div>
              <p class="text-sm font-medium">Enable tax display</p>
              <p class="form-hint mt-0">Show a tax breakdown line on orders and receipts</p>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" name="tax_enabled" value="1"
                {{#if (eq settings.tax_enabled '1')}}checked{{/if}}>
              <span class="toggle-track"></span>
            </label>
          </div>

          <div style="padding-top:0.75rem;border-top:1px solid #f3f4f6;" class="stack-sm">
            <div>
              <label class="form-label">Price display</label>
              <select name="tax_display_mode" class="form-select">
                <option value="inc" {{#if (eq settings.tax_display_mode 'inc')}}selected{{/if}}>Show prices inclusive of tax</option>
                <option value="ex" {{#if (eq settings.tax_display_mode 'ex')}}selected{{/if}}>Show prices exclusive of tax</option>
                <option value="both" {{#if (eq settings.tax_display_mode 'both')}}selected{{/if}}>Show both inclusive and exclusive prices</option>
              </select>
              <p class="form-hint">Controls how prices appear on product pages and listings. The checkout always charges the entered price.</p>
            </div>
            <div>
              <label class="form-label">Tax label</label>
              <input type="text" name="tax_label" value="{{#if settings.tax_label}}{{settings.tax_label}}{{else}}VAT{{/if}}" placeholder="VAT" class="form-input" style="max-width:12rem;">
              <p class="form-hint">Shown to customers, e.g. "VAT", "GST", "Sales Tax"</p>
            </div>
            <div>
              <label class="form-label">Tax / VAT number <span class="form-optional">(optional)</span></label>
              <input type="text" name="tax_number" value="{{settings.tax_number}}" placeholder="GB123456789" class="form-input" style="max-width:16rem;">
              <p class="form-hint">Displayed on receipts and invoices if set</p>
            </div>
            <div style="padding-top:0.5rem;border-top:1px solid #f3f4f6;">
              <p class="text-sm font-medium mb-1">Tax bands</p>
              <p class="form-hint">Tax rates are set per band (e.g. Standard rate, Reduced rate) and assigned to each product.</p>
              <a href="/admin/tax" class="btn btn-secondary btn-sm mt-2" style="display:inline-block;">Manage tax bands →</a>
            </div>
          </div>
        </div>
        <div class="mt-4">
          <button type="submit" class="btn btn-primary">Save tax settings</button>
        </div>
      </form>
    </div>

    <!-- Marketing -->
    <div x-show="tab === 'marketing'" x-cloak>
      <form method="POST" action="/admin/settings/marketing">
        {{csrf_field}}
        <div class="card--no-overflow card-body stack-sm">
          <h2 class="font-semibold">Marketing pixels</h2>
          <p class="form-hint -mt-1">
            Add your advertising tags and they'll load on every storefront page (tracking page views),
            with a purchase/conversion event firing on the order-confirmation page. Leave a field blank to disable it.
          </p>

          <div style="padding-top:0.5rem;border-top:1px solid #f3f4f6;">
            <label class="form-label">Meta (Facebook) Pixel ID</label>
            <input type="text" name="meta_pixel_id" value="{{settings.meta_pixel_id}}" placeholder="1234567890" class="form-input font-mono" style="max-width:20rem;">
            <p class="form-hint">Numeric ID from Meta Events Manager. Fires <code>PageView</code> and <code>Purchase</code>.</p>
          </div>

          <div style="padding-top:0.75rem;border-top:1px solid #f3f4f6;">
            <label class="form-label">Google Analytics 4 measurement ID</label>
            <input type="text" name="ga4_measurement_id" value="{{settings.ga4_measurement_id}}" placeholder="G-XXXXXXXXXX" class="form-input font-mono" style="max-width:20rem;">
            <p class="form-hint">Starts with <code>G-</code>. Fires <code>page_view</code> and a <code>purchase</code> event with order value.</p>
          </div>

          <div style="padding-top:0.75rem;border-top:1px solid #f3f4f6;" class="stack-sm">
            <h3 class="text-sm font-medium">Google Ads conversion <span class="form-optional">(optional)</span></h3>
            <div>
              <label class="form-label-xs">Conversion ID</label>
              <input type="text" name="google_ads_id" value="{{settings.google_ads_id}}" placeholder="AW-XXXXXXXXX" class="form-input font-mono" style="max-width:20rem;">
            </div>
            <div>
              <label class="form-label-xs">Conversion label</label>
              <input type="text" name="google_ads_conversion_label" value="{{settings.google_ads_conversion_label}}" placeholder="abcDEFgh12" class="form-input font-mono" style="max-width:20rem;">
              <p class="form-hint">Both fields fire a Google Ads conversion on the order-confirmation page. Uses the same Google tag as GA4.</p>
            </div>
          </div>

          <div style="padding-top:0.75rem;border-top:1px solid #f3f4f6;">
            <h3 class="text-sm font-medium">Product feed</h3>
            <p class="form-hint">A Google Merchant / Meta Catalog product feed is published automatically at
              <a href="/feed.xml" target="_blank"><code>{{settings.store_url}}/feed.xml</code></a> — paste that URL into Merchant Center or your Meta catalogue.</p>
          </div>
        </div>
        <div class="mt-4">
          <button type="submit" class="btn btn-primary">Save marketing settings</button>
        </div>
      </form>
    </div>

    <!-- Media -->
    <div x-show="tab === 'media'" x-cloak>
      <div class="card--no-overflow card-body stack-sm">
        <h2 class="font-semibold">Media</h2>

        <div>
          <label class="form-label">Logo</label>
          {{#if settings.store_logo}}
          <div class="row mb-3">
            <div style="width:8rem;height:4rem;background:#f9fafb;border:1px solid #e5e7eb;border-radius:0.5rem;display:flex;align-items:center;justify-content:center;padding:0.5rem;">
              <img src="{{settings.store_logo}}" alt="Logo" style="max-height:100%;max-width:100%;object-fit:contain;">
            </div>
            <form method="POST" action="/admin/settings/media/logo/remove">
              {{csrf_field}}
              <button type="submit" class="btn-link btn-link--danger btn-link--xs">Remove</button>
            </form>
          </div>
          {{/if}}
          <form method="POST" action="/admin/settings/media/logo?_csrf={{@root.csrfToken}}" enctype="multipart/form-data">
            {{csrf_field}}
            <div class="row">
              <input type="file" name="file" accept="image/*" required class="form-file flex-1">
              <button type="submit" class="btn btn-primary btn-sm" style="white-space:nowrap;">Upload</button>
            </div>
            <p class="form-hint">PNG, SVG or WebP recommended. Displayed in the store header.</p>
          </form>
        </div>

        <div>
          <label class="form-label">Site icon <span class="form-optional">(favicon)</span></label>
          {{#if settings.store_icon}}
          <div class="row mb-3">
            <div style="width:4rem;height:4rem;background:#f9fafb;border:1px solid #e5e7eb;border-radius:0.5rem;display:flex;align-items:center;justify-content:center;padding:0.5rem;">
              <img src="{{settings.store_icon}}" alt="Icon" style="max-height:100%;max-width:100%;object-fit:contain;">
            </div>
            <form method="POST" action="/admin/settings/media/icon/remove">
              {{csrf_field}}
              <button type="submit" class="btn-link btn-link--danger btn-link--xs">Remove</button>
            </form>
          </div>
          {{/if}}
          <form method="POST" action="/admin/settings/media/icon?_csrf={{@root.csrfToken}}" enctype="multipart/form-data">
            {{csrf_field}}
            <div class="row">
              <input type="file" name="file" accept="image/png,image/x-icon,image/vnd.microsoft.icon,image/svg+xml" required class="form-file flex-1">
              <button type="submit" class="btn btn-primary btn-sm" style="white-space:nowrap;">Upload</button>
            </div>
            <p class="form-hint">Square PNG or ICO, 32×32 or 64×64px. Shown in browser tabs.</p>
          </form>
        </div>
      </div>
    </div>

    <!-- Logs -->
    <div x-show="tab === 'logs'" x-cloak x-data="{ section: 'email' }">

      <!-- Sub-nav -->
      <div style="display:flex;gap:0.25rem;margin-bottom:1rem;border-bottom:1px solid #e5e7eb;">
        <button @click="section = 'email'" :class="section === 'email' ? 'settings-tab settings-tab--active' : 'settings-tab'" class="settings-tab" style="border-bottom:2px solid transparent;margin-bottom:-1px;">Email</button>
        <button @click="section = 'payments'" :class="section === 'payments' ? 'settings-tab settings-tab--active' : 'settings-tab'" class="settings-tab" style="border-bottom:2px solid transparent;margin-bottom:-1px;">Payments</button>
        <button @click="section = 'errors'" :class="section === 'errors' ? 'settings-tab settings-tab--active' : 'settings-tab'" class="settings-tab" style="border-bottom:2px solid transparent;margin-bottom:-1px;">
          Errors
          {{#if errorLog.length}}<span class="badge badge-red" style="margin-left:0.25rem;">{{errorLog.length}}</span>{{/if}}
        </button>
      </div>

      <!-- Email log -->
      <div x-show="section === 'email'">
        <div class="card">
          <div style="padding:0.75rem 1.25rem;border-bottom:1px solid #f3f4f6;display:flex;align-items:center;justify-content:space-between;">
            <span class="text-xs font-medium text-muted" style="text-transform:uppercase;letter-spacing:0.05em;">Email sends</span>
            <span class="text-xs text-muted">Last 50</span>
          </div>
          {{#if emailLog.length}}
            <div>
              {{#each emailLog}}
                <div class="log-entry">
                  <span class="log-dot {{#if (eq this.status 'sent')}}log-dot--green{{else}}log-dot--red{{/if}}"></span>
                  <div style="flex:1;min-width:0;">
                    <div style="display:flex;align-items:baseline;gap:0.5rem;flex-wrap:wrap;">
                      <span class="font-medium" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{this.subject}}</span>
                      <span class="text-xs text-muted">→ {{this.to_address}}</span>
                    </div>
                    <div class="text-xs text-muted mt-1">
                      {{this.provider}}{{#if this.template_key}} · {{this.template_key}}{{/if}} · {{this.created_at}}
                    </div>
                    {{#if this.error}}
                      <p class="text-xs font-mono" style="margin-top:0.25rem;color:#dc2626;background:#fef2f2;border-radius:0.25rem;padding:0.25rem 0.5rem;word-break:break-all;">{{this.error}}</p>
                    {{/if}}
                  </div>
                </div>
              {{/each}}
            </div>
          {{else}}
            <p style="padding:2.5rem 1.25rem;text-align:center;font-size:0.875rem;color:#9ca3af;">No emails sent yet.</p>
          {{/if}}
        </div>
      </div>

      <!-- Payment log -->
      <div x-show="section === 'payments'">
        <div class="card">
          <div style="padding:0.75rem 1.25rem;border-bottom:1px solid #f3f4f6;display:flex;align-items:center;justify-content:space-between;">
            <span class="text-xs font-medium text-muted" style="text-transform:uppercase;letter-spacing:0.05em;">Payment events</span>
            <span class="text-xs text-muted">Last 50</span>
          </div>
          {{#if paymentLog.length}}
            <div>
              {{#each paymentLog}}
                <div class="log-entry">
                  <span class="log-dot {{#if (eq this.level 'info')}}log-dot--green{{else if (eq this.level 'warn')}}log-dot--yellow{{else}}log-dot--red{{/if}}"></span>
                  <div style="flex:1;min-width:0;">
                    <span class="font-medium">{{this.message}}</span>
                    <div class="text-xs text-muted mt-1">{{this.created_at}}</div>
                    {{#if this.meta}}
                      <div class="text-xs text-muted font-mono" style="margin-top:0.25rem;background:#f9fafb;border-radius:0.25rem;padding:0.375rem 0.5rem;">
                        {{#each (jsonParse this.meta)}}
                          <div><span class="text-muted">{{@key}}</span> {{this}}</div>
                        {{/each}}
                      </div>
                    {{/if}}
                  </div>
                </div>
              {{/each}}
            </div>
          {{else}}
            <p style="padding:2.5rem 1.25rem;text-align:center;font-size:0.875rem;color:#9ca3af;">No payment events yet.</p>
          {{/if}}
        </div>
      </div>

      <!-- Error log -->
      <div x-show="section === 'errors'">
        <div class="card">
          <div style="padding:0.75rem 1.25rem;border-bottom:1px solid #f3f4f6;display:flex;align-items:center;justify-content:space-between;">
            <span class="text-xs font-medium text-muted" style="text-transform:uppercase;letter-spacing:0.05em;">Errors</span>
            <span class="text-xs text-muted">Last 50</span>
          </div>
          {{#if errorLog.length}}
            <div>
              {{#each errorLog}}
                <div class="log-entry">
                  <span class="log-dot log-dot--red"></span>
                  <div style="flex:1;min-width:0;">
                    <span class="font-medium">{{this.message}}</span>
                    <div class="text-xs text-muted mt-1">{{this.created_at}}</div>
                    {{#if this.meta}}
                      <div class="text-xs text-muted font-mono" style="margin-top:0.25rem;background:#f9fafb;border-radius:0.25rem;padding:0.375rem 0.5rem;">
                        {{#each (jsonParse this.meta)}}
                          <div><span class="text-muted">{{@key}}</span> {{this}}</div>
                        {{/each}}
                      </div>
                    {{/if}}
                  </div>
                </div>
              {{/each}}
            </div>
          {{else}}
            <p style="padding:2.5rem 1.25rem;text-align:center;font-size:0.875rem;color:#9ca3af;">No errors logged.</p>
          {{/if}}
        </div>
      </div>

    </div>

    <!-- Server -->
    <div x-show="tab === 'server'" x-cloak class="stack-sm">
      {{#if cloudMode}}
      <div class="card--no-overflow card-body stack-sm">
        <h2 class="font-semibold mb-1">Updates</h2>
        <p class="form-hint">
          Squaark Cloud keeps this store up to date for you — there is nothing to do here.
        </p>
      </div>
      {{else}}
      <div class="card--no-overflow card-body stack-sm">
        <h2 class="font-semibold mb-1">Version</h2>
        {{#if update}}
          {{#if update.updateAvailable}}
          <p class="form-hint">A new version is available — you're <strong>{{update.behind}}</strong> commit{{#unless (eq update.behind 1)}}s{{/unless}} behind{{#if update.currentVersion}} (on {{update.currentVersion}}){{/if}}. Update through your normal deployment (pull the latest code &amp; redeploy).{{#if update.currentSha}} <a href="https://github.com/Squaark/squaark/compare/{{update.currentSha}}...master" target="_blank" rel="noopener">See what's changed</a>.{{/if}}</p>
          {{else if update.error}}
          <p class="form-hint" style="color:#92400e;background:#fffbeb;border:1px solid #fde68a;border-radius:0.375rem;padding:0.5rem 0.65rem;">Couldn't check for updates: {{update.error}}<br>You're on version <strong>{{update.currentVersion}}</strong>.</p>
          {{else if update.isGitCheckout}}
          <p class="form-hint">You're up to date{{#if update.currentVersion}} (version {{update.currentVersion}}){{/if}}.</p>
          {{else}}
          <p class="form-hint">You're on version <strong>{{update.currentVersion}}</strong>.</p>
          {{/if}}
        {{else}}
          <p class="form-hint">Checking for updates…</p>
        {{/if}}
      </div>
      {{/if}}

      <div class="card--no-overflow card-body">
        <h2 class="font-semibold mb-1">Server</h2>
        <p class="form-hint mb-4">Restart the server after upgrading, changing environment variables, or installing a new theme.</p>
        <button id="restart-btn" onclick="doRestart()" class="btn btn-primary">Restart server</button>
        <div id="restart-status" style="display:none;margin-top:0.75rem;font-size:0.875rem;color:#6b7280;"></div>
      </div>

      <div class="card--no-overflow card-body">
        <h2 class="font-semibold mb-1">Export &amp; import store</h2>
        <p class="form-hint">Back up or migrate your whole store — moved to <a href="/admin/import">Import / Export</a>.</p>
      </div>
    </div>

  </div>
</div>

<script>
var CSRF_TOKEN = '{{csrfToken}}';

function settingsTabs() {
  const hash = window.location.hash.replace('#', '');
  const valid = ['store', 'email', 'payments', 'tax', 'marketing', 'media', 'server', 'logs'];
  return {
    tab: valid.includes(hash) ? hash : 'store',
  };
}

function savePayments() {
  const fields = ['stripe_pk', 'stripe_sk', 'stripe_webhook_secret', 'paypal_client_id', 'paypal_client_secret', 'paypal_mode'];
  const form = document.createElement('form');
  form.method = 'POST';
  form.action = '/admin/settings/payments';
  const csrfInput = document.createElement('input');
  csrfInput.type = 'hidden';
  csrfInput.name = '_csrf';
  csrfInput.value = CSRF_TOKEN;
  form.appendChild(csrfInput);
  fields.forEach(name => {
    const el = document.getElementById(name);
    const inp = document.createElement('input');
    inp.type = 'hidden';
    inp.name = name;
    inp.value = el ? el.value : '';
    form.appendChild(inp);
  });
  document.body.appendChild(form);
  form.submit();
}

async function doRestart() {
  if (!confirm('Restart the server? The admin will be unavailable for a few seconds.')) return;
  const btn = document.getElementById('restart-btn');
  const status = document.getElementById('restart-status');
  btn.disabled = true;
  btn.textContent = 'Restarting…';
  status.style.display = 'block';
  status.textContent = 'Waiting for server…';

  try { await fetch('/admin/settings/restart', { method: 'POST', headers: { 'X-CSRF-Token': CSRF_TOKEN } }); } catch {}

  const poll = async () => {
    try {
      const res = await fetch('/admin', { method: 'GET', cache: 'no-store' });
      if (res.ok) { window.location.reload(); return; }
    } catch {}
    setTimeout(poll, 1000);
  };
  setTimeout(poll, 1500);
}
</script>
