<div class="page-header">
  <h1 class="page-title">My account</h1>
</div>

{{#if profileSaved}}<div class="alert alert-success">Profile updated.</div>{{/if}}
{{#if passwordSaved}}<div class="alert alert-success">Password changed.</div>{{/if}}
{{#if twoFactorEnabledMsg}}<div class="alert alert-success">Two-factor authentication is now on.</div>{{/if}}
{{#if twoFactorDisabledMsg}}<div class="alert alert-success">Two-factor authentication is now off.</div>{{/if}}
{{#if error}}
<div class="alert alert-error">
  {{#if (eq error 'missing_fields')}}Please fill in all the fields.{{/if}}
  {{#if (eq error 'email_taken')}}That email address is already in use by another user.{{/if}}
  {{#if (eq error 'too_short')}}Your new password must be at least 8 characters.{{/if}}
  {{#if (eq error 'mismatch')}}The new passwords don't match.{{/if}}
  {{#if (eq error 'wrong_password')}}Your current password is incorrect.{{/if}}
  {{#if (eq error 'email_required')}}Set up an email provider in Settings → Email before enabling two-factor authentication.{{/if}}
  {{#if (eq error '2fa_failed')}}Couldn't confirm the code. Two-factor authentication was not enabled — try again.{{/if}}
</div>
{{/if}}

<div class="grid-form">

  <!-- Profile -->
  <div class="card--no-overflow card-body stack-sm">
    <h2 class="font-semibold">Profile</h2>
    <p class="text-xs text-muted">Your name and the email you sign in with. Role:
      <span class="badge badge-dark">{{admin.role}}</span></p>
    <form method="POST" action="/admin/account/profile" class="stack-sm">
      {{csrf_field}}
      <div>
        <label class="form-label-xs">Name</label>
        <input type="text" name="name" value="{{admin.name}}" required class="form-input">
      </div>
      <div>
        <label class="form-label-xs">Email</label>
        <input type="email" name="email" value="{{admin.email}}" required class="form-input">
      </div>
      <button type="submit" class="btn btn-primary">Save profile</button>
    </form>
  </div>

  <!-- Password -->
  <div class="card--no-overflow card-body stack-sm">
    <h2 class="font-semibold">{{#if admin.hasPassword}}Change password{{else}}Set a password{{/if}}</h2>
    {{#unless admin.hasPassword}}
    <p class="form-hint -mt-1">You signed in from Taberno Cloud, so this account has no password yet. Set one to sign in directly, without going through your dashboard.</p>
    {{/unless}}
    <form method="POST" action="/admin/account/password" class="stack-sm">
      {{csrf_field}}
      {{#if admin.hasPassword}}
      <div>
        <label class="form-label-xs">Current password</label>
        <input type="password" name="current" required autocomplete="current-password" class="form-input">
      </div>
      {{/if}}
      <div>
        <label class="form-label-xs">New password</label>
        <input type="password" name="password" required minlength="8" autocomplete="new-password" class="form-input">
      </div>
      <div>
        <label class="form-label-xs">Confirm new password</label>
        <input type="password" name="confirm" required minlength="8" autocomplete="new-password" class="form-input">
      </div>
      <button type="submit" class="btn btn-primary">{{#if admin.hasPassword}}Change password{{else}}Set password{{/if}}</button>
    </form>
  </div>

  <!-- Two-factor authentication -->
  <div class="card--no-overflow card-body stack-sm">
    <h2 class="font-semibold">Two-factor authentication</h2>
    <p class="text-xs text-muted">Require a one-time code emailed to <strong>{{admin.email}}</strong> each time you sign in.</p>
    {{#if twoFactorEnabled}}
      <p class="text-sm"><span class="badge badge-green">On</span></p>
      <form method="POST" action="/admin/account/2fa/disable" class="stack-sm"
            onsubmit="return confirm('Turn off two-factor authentication for your account?')">
        {{csrf_field}}
        <div>
          <label class="form-label-xs">Confirm your password to turn it off</label>
          <input type="password" name="password" required autocomplete="current-password" class="form-input">
        </div>
        <button type="submit" class="btn" style="color:#b91c1c;border-color:#fecaca;">Turn off</button>
      </form>
    {{else}}
      <p class="text-sm"><span class="badge badge-gray">Off</span></p>
      {{#if emailConfigured}}
        <p class="form-hint">We'll email a code to confirm it's working before turning it on.</p>
        <form method="POST" action="/admin/account/2fa/enable">
          {{csrf_field}}
          <button type="submit" class="btn btn-primary">Turn on</button>
        </form>
      {{else}}
        <p class="form-hint" style="color:#92400e;background:#fffbeb;border:1px solid #fde68a;border-radius:0.375rem;padding:0.5rem 0.65rem;">
          Set up an email provider in <a href="/admin/settings#email">Settings → Email</a> first — the login code is sent by email.
        </p>
      {{/if}}
    {{/if}}
  </div>

</div>
