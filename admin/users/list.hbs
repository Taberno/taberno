<div class="page-header">
  <h1 class="page-title">Users</h1>
</div>

{{#if saved}}<div class="alert alert-success">Saved.</div>{{/if}}
{{#if error}}
<div class="alert alert-error">
  {{#if (eq error 'email_taken')}}That email address is already in use.{{/if}}
  {{#if (eq error 'missing_fields')}}Name, email and password are all required.{{/if}}
  {{#if (eq error 'last_admin')}}There must be at least one admin — promote another user first.{{/if}}
  {{#if (eq error 'staff_limit')}}You've reached the number of staff accounts your plan includes. Upgrade in Taberno Cloud to add more.{{/if}}
  {{#if (eq error 'cannot_delete_self')}}You can't delete your own account. Edit it under <a href="/admin/account">My account</a>.{{/if}}
  {{#if (eq error 'cannot_change_own_role')}}You can't change your own role.{{/if}}
  {{#if (eq error 'too_short')}}Passwords must be at least 8 characters.{{/if}}
</div>
{{/if}}

<div class="grid-form">

  <!-- User list -->
  <div>
    <div class="card">
      <table class="data-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Joined</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {{#each users}}
          <tr>
            <td class="font-medium">
              {{this.name}}
              {{#if (eq this.id ../admin.id)}}<span class="text-xs text-muted font-normal">(you)</span>{{/if}}
            </td>
            <td class="text-muted">{{this.email}}</td>
            <td>
              {{#if (eq this.id ../admin.id)}}
              <span class="badge badge-dark">{{this.role}}</span>
              {{else}}
              <form method="POST" action="/admin/users/{{this.id}}/role" style="display:inline-flex;align-items:center;gap:0.25rem;">
                {{csrf_field}}
                <select name="role" onchange="this.form.submit()" class="form-select" style="font-size:0.75rem;padding:0.125rem 0.375rem;">
                  <option value="admin" {{#if (eq this.role 'admin')}}selected{{/if}}>Admin</option>
                  <option value="staff" {{#if (eq this.role 'staff')}}selected{{/if}}>Staff</option>
                </select>
              </form>
              {{/if}}
            </td>
            <td class="text-muted text-xs">{{date_short this.created_at}}</td>
            <td class="right">
              {{#if (eq this.id ../admin.id)}}
              <a href="/admin/account" class="btn-link btn-link--xs">Edit in My account</a>
              {{else}}
              <div style="display:flex;gap:0.75rem;align-items:center;justify-content:flex-end;">
                <form method="POST" action="/admin/users/{{this.id}}/password"
                  style="display:inline-flex;gap:0.25rem;align-items:center;"
                  onsubmit="return confirm('Set a new password for {{this.name}}?')">
                  {{csrf_field}}
                  <input type="password" name="password" placeholder="New password" minlength="8" required
                    autocomplete="new-password"
                    class="form-input" style="width:9rem;font-size:0.75rem;padding:0.125rem 0.375rem;">
                  <button type="submit" class="btn-link btn-link--xs">Set</button>
                </form>
                <form method="POST" action="/admin/users/{{this.id}}/delete"
                  onsubmit="return confirm('Delete {{this.name}}? This cannot be undone.')">
                  {{csrf_field}}
                  <button type="submit" class="btn-link btn-link--danger btn-link--xs">Delete</button>
                </form>
              </div>
              {{/if}}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Add user form -->
  <div class="stack-sm">
    <div class="card--no-overflow card-body stack-sm">
      <h2 class="font-semibold">Add user</h2>

      {{#if atStaffLimit}}
        {{!-- The button is disabled AND the server refuses; this is the
              courtesy, the check in the route is the rule. --}}
        <p class="form-hint" style="color:#92400e;background:#fffbeb;border:1px solid #fde68a;border-radius:0.375rem;padding:0.5rem 0.65rem;">
          Staff account limit reached. Upgrade your plan at
          <a href="https://cloud.taberno.io/billing" target="_blank" rel="noopener" style="color:#92400e;text-decoration:underline;">cloud.taberno.io</a>.
        </p>
      {{/if}}

      <form method="POST" action="/admin/users" class="stack-sm">
        {{csrf_field}}
        <div>
          <label class="form-label-xs">Name</label>
          <input type="text" name="name" required class="form-input">
        </div>
        <div>
          <label class="form-label-xs">Email</label>
          <input type="email" name="email" required class="form-input">
        </div>
        <div>
          <label class="form-label-xs">Password</label>
          <input type="password" name="password" required minlength="8" class="form-input">
        </div>
        <div>
          <label class="form-label-xs">Role</label>
          <select name="role" class="form-select">
            <option value="staff">Staff — products &amp; orders only</option>
            <option value="admin">Admin — full access</option>
          </select>
        </div>
        <button type="submit" class="btn btn-primary btn-block"
                {{#if atStaffLimit}}disabled title="Staff account limit reached"{{/if}}>Add user</button>
      </form>
    </div>
    <p class="text-xs text-muted">
      Staff can manage products, collections and orders but cannot access settings, themes, or import.
    </p>
  </div>

</div>
