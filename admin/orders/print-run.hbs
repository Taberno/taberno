<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Packing slips — {{date}}</title>
  {{> print-styles}}
</head>
<body>
  <div class="toolbar no-print">
    <button class="btn" onclick="window.print()">Print all</button>
    <span>{{count}} {{fulfillment}} order{{#unless (eq count 1)}}s{{/unless}} · {{date}}</span>
    {{#if capped}}<span class="warn">Showing the first {{cap}} — narrow the date to print the rest.</span>{{/if}}
    <form method="get" action="/admin/orders/print" style="margin-left:auto;display:flex;gap:6px;align-items:center;">
      <input type="hidden" name="status" value="{{fulfillment}}">
      <input type="date" name="date" value="{{date}}">
      <button class="btn" type="submit">Reload</button>
    </form>
  </div>
  {{#if slips.length}}
    {{#each slips}}
    <section class="page">{{> packing-slip-body this}}</section>
    {{/each}}
  {{else}}
    <div class="sheet"><p class="muted">No {{fulfillment}} orders for {{date}}.</p></div>
  {{/if}}
</body>
</html>
