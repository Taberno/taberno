<div class="page-header__left mb-6">
  <a href="/admin/orders" class="page-back">← Orders</a>
  <h1 class="page-title">Order #{{order.order_number}}</h1>
  {{{status_badge order.status}}}
</div>

<div class="grid-form">
  <div class="stack">
    <div class="card">
      <div class="card-header">Items</div>
      <table class="data-table">
        <tbody>
          {{#each items}}
          <tr>
            <td>
              <p class="cell-title">{{this.product_title}}</p>
              <p class="cell-hint">{{this.variant_title}}{{#if this.sku}} · SKU: {{this.sku}}{{/if}}</p>
              {{#if this.preorder}}<p class="cell-hint" style="color:#1e40af;font-weight:600;">Pre-order · ships from {{date_short this.preorder_available_from}}</p>{{/if}}
            </td>
            <td class="right text-muted">× {{this.quantity}}</td>
            <td class="right cell-title">£{{money_pence this.line_total}}</td>
          </tr>
          {{/each}}
        </tbody>
        <tfoot>
          <tr>
            <td colspan="2">Subtotal</td>
            <td class="right">£{{money_pence order.subtotal}}</td>
          </tr>
          {{#if order.discount_amount}}
          <tr>
            <td colspan="2">Discount{{#if order.discount_code}} ({{order.discount_code}}){{/if}}</td>
            <td class="right text-success">−£{{money_pence order.discount_amount}}</td>
          </tr>
          {{/if}}
          {{#if order.shipping}}
          <tr>
            <td colspan="2">Shipping{{#if order.shipping_title}} ({{order.shipping_title}}){{/if}}</td>
            <td class="right">£{{money_pence order.shipping}}</td>
          </tr>
          {{/if}}
          <tr>
            <td colspan="2" class="font-semibold">Total</td>
            <td class="right font-semibold">£{{money_pence order.total}}</td>
          </tr>
          {{#if order.tax_amount}}
          <tr class="text-muted">
            <td colspan="2">{{#if settings.tax_label}}{{settings.tax_label}}{{else}}VAT{{/if}} included</td>
            <td class="right">£{{money_pence order.tax_amount}}</td>
          </tr>
          {{/if}}
        </tfoot>
      </table>
    </div>
  </div>

  <div class="stack-sm">
    <div class="card--no-overflow card-body">
      <h2 class="font-semibold text-sm mb-3">Customer</h2>
      <p class="text-sm">{{order.email}}</p>
    </div>

    <div class="card--no-overflow card-body stack-sm">
      <h2 class="font-semibold text-sm">Print</h2>
      {{#unless seller.complete}}
      <p class="text-xs" style="color:#92400e;background:#fffbeb;border:1px solid #fde68a;border-radius:0.375rem;padding:0.4rem 0.55rem;">
        Add your <a href="/admin/settings#store">business name &amp; address</a> so invoices work as a business record{{#unless settings.tax_number}}, plus your VAT number under <a href="/admin/settings#tax">Tax</a> if you're VAT-registered{{/unless}}.
      </p>
      {{/unless}}
      <div class="row" style="gap:0.5rem;">
        <a href="/admin/orders/{{order.id}}/packing-slip" target="_blank" rel="noopener" class="btn btn-secondary btn-sm">Packing slip</a>
        <a href="/admin/orders/{{order.id}}/invoice" target="_blank" rel="noopener" class="btn btn-secondary btn-sm">Invoice</a>
      </div>
    </div>

    {{#if order.pickup_address}}
    <div class="card--no-overflow card-body">
      <h2 class="font-semibold text-sm mb-2">Collection</h2>
      <p class="text-sm" style="white-space:pre-line;">{{order.pickup_address}}</p>
      {{#if order.pickup_instructions}}<p class="text-xs text-muted" style="margin-top:0.35rem;white-space:pre-line;">{{order.pickup_instructions}}</p>{{/if}}
      <p class="text-xs" style="color:#1e40af;margin-top:0.5rem;">Customer is collecting — no delivery.</p>
    </div>
    {{/if}}

    {{#if order.fulfilment_date}}
    <div class="card--no-overflow card-body">
      <h2 class="font-semibold text-sm mb-2">Booked slot</h2>
      <p class="text-sm">{{date_short order.fulfilment_date}}{{#if order.fulfilment_window}} · {{order.fulfilment_window}}{{/if}}</p>
    </div>
    {{/if}}

    <div class="card--no-overflow card-body stack-sm">
      <h2 class="font-semibold text-sm">Fulfillment</h2>
      {{#if fulfilled}}<p class="text-xs text-success">Fulfillment updated.</p>{{/if}}
      <p class="text-xs text-muted">
        Current: <span class="font-medium">{{order.fulfillment}}</span>{{#if order.shipped_at}} · shipped {{date_short order.shipped_at}}{{/if}}
      </p>
      <form method="POST" action="/admin/orders/{{order.id}}/fulfillment" class="stack-sm">
        {{csrf_field}}
        <div>
          <label class="form-label-xs">Status</label>
          <select name="fulfillment" class="form-select">
            {{#each fulfillmentStates}}
            <option value="{{this}}" {{#if (eq this ../order.fulfillment)}}selected{{/if}}>{{this}}</option>
            {{/each}}
          </select>
        </div>
        <div>
          <label class="form-label-xs">Tracking number</label>
          <input type="text" name="tracking_number" value="{{order.tracking_number}}" placeholder="e.g. AB123456789GB" class="form-input">
        </div>
        <div>
          <label class="form-label-xs">Tracking URL</label>
          <input type="url" name="tracking_url" value="{{order.tracking_url}}" placeholder="https://…" class="form-input">
        </div>
        <p class="form-hint">Marking an order <strong>shipped</strong> for the first time emails the customer their tracking link.</p>
        <button type="submit" class="btn btn-primary">Save fulfillment</button>
      </form>
    </div>

    {{#if isInvoice}}
    <div class="card--no-overflow card-body">
      <h2 class="font-semibold text-sm mb-2">Invoice (on account)</h2>
      <p class="text-sm">{{#if (eq order.status 'paid')}}Paid.{{else}}Awaiting payment.{{/if}}{{#if order.due_date}} Payment due {{date_short order.due_date}}.{{/if}}</p>
      <p class="text-xs" style="color:#1e40af;margin-top:0.5rem;">No card was taken — mark this order <strong>paid</strong> below once the invoice is settled.</p>
    </div>
    {{/if}}

    <div class="card--no-overflow card-body stack-sm">
      <h2 class="font-semibold text-sm">Payment status</h2>
      {{#if statusUpdated}}<p class="text-xs text-success">Status updated.</p>{{/if}}
      {{#if refunded}}<p class="text-xs text-success">Payment refunded.</p>{{/if}}
      {{#if refundError}}<p class="text-xs" style="color:#b91c1c;">Refund failed: {{refundError}}</p>{{/if}}
      <form method="POST" action="/admin/orders/{{order.id}}/status" class="stack-sm">
        {{csrf_field}}
        <select name="status" class="form-select">
          {{#each orderStatuses}}
          <option value="{{this}}" {{#if (eq this ../order.status)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>
        <p class="form-hint">Sets the recorded status only — it does not issue a payment refund with Stripe/PayPal.</p>
        <button type="submit" class="btn">Update status</button>
      </form>

      {{#if canRefund}}
      <form method="POST" action="/admin/orders/{{order.id}}/refund" onsubmit="return confirm('Refund the full amount to the customer via {{order.payment_provider}}? This cannot be undone.');" style="padding-top:0.75rem;border-top:1px solid #f3f4f6;">
        {{csrf_field}}
        <p class="form-hint">Issues a full refund through {{order.payment_provider}} and marks the order refunded.</p>
        <button type="submit" class="btn" style="color:#b91c1c;border-color:#fecaca;">Refund payment</button>
      </form>
      {{/if}}
    </div>

    <div class="card--no-overflow card-body-sm text-xs text-muted stack-xs">
      <p>Placed {{date_short order.created_at}}</p>
      {{#if order.payment_provider}}{{#if isInvoice}}<p>Pay on account (invoice)</p>{{else}}<p>Paid via {{order.payment_provider}}</p>{{/if}}{{/if}}
    </div>
  </div>
</div>
