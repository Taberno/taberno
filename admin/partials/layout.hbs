<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{pageTitle}} — {{or settings.store_name "Taberno"}} Admin</title>
  <link rel="stylesheet" href="/public/admin.css">
  <script src="/public/vendor/htmx-2.0.3.min.js"></script>
  <script src="/public/vendor/alpine-3.15.12.min.js" defer></script>
</head>
<body>
  <div class="admin-layout">
    <!-- Sidebar -->
    <aside class="admin-sidebar">
      <div class="admin-sidebar__brand">
        <span class="admin-sidebar__brand-name">{{settings.store_name}}</span>
        <p class="admin-sidebar__brand-sub">Admin</p>
      </div>
      <nav class="admin-sidebar__nav">
        <a href="/admin" class="sidebar-link {{#if (eq pageTitle 'Dashboard')}}active{{/if}}">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          Dashboard
        </a>
        <a href="/admin/analytics" class="sidebar-link {{#if (eq pageSection 'analytics')}}active{{/if}}">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
          Analytics
        </a>

        <p class="sidebar-group">Catalog</p>
        <a href="/admin/products" class="sidebar-link {{#if (eq pageSection 'products')}}active{{/if}}">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
          Products
        </a>
        <a href="/admin/collections" class="sidebar-link {{#if (eq pageSection 'collections')}}active{{/if}}">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
          Collections
        </a>

        <p class="sidebar-group">Sales</p>
        <a href="/admin/orders" class="sidebar-link {{#if (eq pageSection 'orders')}}active{{/if}}">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
          Orders
        </a>
        <a href="/admin/customers" class="sidebar-link {{#if (eq pageSection 'customers')}}active{{/if}}">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          Customers
        </a>
        <a href="/admin/reviews" class="sidebar-link {{#if (eq pageSection 'reviews')}}active{{/if}}">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
          Reviews
        </a>
        <a href="/admin/discounts" class="sidebar-link {{#if (eq pageSection 'promotions')}}active{{/if}}">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5a1.99 1.99 0 011.41.59l7 7a2 2 0 010 2.82l-5 5a2 2 0 01-2.82 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/></svg>
          Promotions
        </a>
        <a href="/admin/newsletter" class="sidebar-link {{#if (eq pageSection 'newsletter')}}active{{/if}}">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          Newsletter
        </a>

        <p class="sidebar-group">Content</p>
        <a href="/admin/pages" class="sidebar-link {{#if (or (eq pageSection 'pages') (or (eq pageSection 'blocks') (eq pageSection 'templates')))}}active{{/if}}">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          Pages
        </a>
        <a href="/admin/posts" class="sidebar-link {{#if (eq pageSection 'blog')}}active{{/if}}">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m0 0h3a1 1 0 011 1v10a2 2 0 01-2 2M7 8h6M7 12h4"/></svg>
          Blog
        </a>

        <p class="sidebar-group">Store settings</p>
        <a href="/admin/shipping" class="sidebar-link {{#if (eq pageSection 'shipping')}}active{{/if}}">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
          Shipping
        </a>
        <a href="/admin/tax" class="sidebar-link {{#if (eq pageSection 'tax')}}active{{/if}}">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z"/></svg>
          Tax
        </a>
        {{#if (eq admin.role 'admin')}}
        <p class="sidebar-group">Configuration</p>
        <a href="/admin/navigation" class="sidebar-link {{#if (eq pageSection 'navigation')}}active{{/if}}">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
          Navigation
        </a>
        <a href="/admin/themes" class="sidebar-link {{#if (eq pageSection 'themes')}}active{{/if}}">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>
          Themes
        </a>
        <a href="/admin/emails" class="sidebar-link {{#if (eq pageSection 'emails')}}active{{/if}}">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          Emails
        </a>
        <a href="/admin/users" class="sidebar-link {{#if (eq pageSection 'users')}}active{{/if}}">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          Users
        </a>
        <a href="/admin/settings" class="sidebar-link {{#if (eq pageSection 'settings')}}active{{/if}}">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          Settings
        </a>
        {{/if}}
      </nav>
      <div class="admin-sidebar__footer">
        <a href="/admin/account" class="sidebar-link {{#if (eq pageSection 'account')}}active{{/if}}">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          {{admin.name}}
        </a>
        <a href="{{featureRequestUrl}}" target="_blank" rel="noopener"
           class="sidebar-link" style="font-size:0.8rem;opacity:0.75;">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 21h6M10 17h4a5 5 0 10-4 0zM12 3v1M4.2 6.2l.7.7M2 13h1M21 13h1M19.1 6.9l-.7.7"/></svg>
          Request a feature
        </a>
        {{#if cloudMode}}
        <a href="https://cloud.taberno.io" target="_blank" rel="noopener"
           class="sidebar-link" style="font-size:0.75rem;opacity:0.65;">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2A4.002 4.002 0 003 15z"/></svg>
          Hosted by Taberno Cloud
        </a>
        {{/if}}
        <form method="POST" action="/admin/logout">
          {{csrf_field}}
          <button type="submit" class="sidebar-link btn-link--danger" style="width:100%;text-align:left;color:#ef4444">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            Sign out
          </button>
        </form>
      </div>
    </aside>

    <!-- Main content -->
    <main class="admin-main">
      {{#if (and update.updateAvailable (not cloudMode))}}
      <div style="background:#eff6ff;border-bottom:1px solid #bfdbfe;padding:0.6rem 1.5rem;font-size:0.85rem;color:#1e40af;display:flex;align-items:center;justify-content:center;gap:0.75rem;flex-wrap:wrap;">
        <span>⬆︎ An update is available — you're <strong>{{update.behind}}</strong> commit{{#unless (eq update.behind 1)}}s{{/unless}} behind.</span>
        <a href="https://github.com/taberno/taberno/compare/{{update.currentSha}}...master" target="_blank" rel="noopener" style="color:#1d4ed8;text-decoration:underline;">See what's changed</a>
      </div>
      {{/if}}
      <div class="{{#if fullWidth}}admin-content--wide{{else}}admin-content{{/if}}">
        {{{body}}}
      </div>
    </main>
  </div>
</body>
</html>
