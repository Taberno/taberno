<style>
  :root { color-scheme: light; }
  * { box-sizing: border-box; }
  html, body { margin: 0; background: #fff; color: #111; }
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; line-height: 1.5; }
  .sheet { max-width: 760px; margin: 0 auto; padding: 32px; }
  h1 { font-size: 20px; margin: 0 0 2px; }
  h2 { font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: #555; margin: 0 0 6px; }
  p { margin: 0; }
  .muted { color: #666; }
  .doc-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; border-bottom: 2px solid #111; padding-bottom: 12px; margin-bottom: 22px; }
  .blocks { display: flex; gap: 40px; flex-wrap: wrap; margin-bottom: 22px; }
  .block { min-width: 200px; }
  address { font-style: normal; line-height: 1.5; font-size: 13px; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th, td { text-align: left; padding: 7px 8px; border-bottom: 1px solid #ddd; vertical-align: top; }
  th { font-size: 11px; text-transform: uppercase; letter-spacing: 0.03em; color: #555; border-bottom: 2px solid #111; }
  td.num, th.num { text-align: right; white-space: nowrap; }
  .qty { font-weight: 700; }
  .totals { width: 300px; margin-left: auto; margin-top: 14px; }
  .totals td { border: none; padding: 3px 8px; }
  .totals .total td { border-top: 2px solid #111; font-weight: 700; font-size: 15px; padding-top: 8px; }
  .notes { margin-top: 20px; padding: 10px 12px; border: 1px solid #bbb; border-radius: 4px; font-size: 13px; }
  /* Bulk run: one order per page. */
  .page { break-after: page; }
  .page:last-child { break-after: auto; }
  /* On-screen controls, hidden when actually printing. */
  .toolbar { position: sticky; top: 0; z-index: 1; background: #f3f4f6; border-bottom: 1px solid #d1d5db; padding: 10px 16px; display: flex; gap: 12px; align-items: center; font-size: 13px; }
  .toolbar .btn { background: #111; color: #fff; border: none; border-radius: 5px; padding: 6px 14px; font-size: 13px; cursor: pointer; text-decoration: none; }
  .toolbar input[type="date"] { padding: 4px 6px; border: 1px solid #ccc; border-radius: 4px; font-size: 13px; }
  .toolbar .warn { background: #fffbeb; border: 1px solid #fde68a; color: #92400e; padding: 4px 8px; border-radius: 4px; }
  @media print {
    .no-print { display: none !important; }
    .sheet { max-width: none; margin: 0; padding: 0; }
    body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    @page { margin: 16mm; }
  }
</style>
